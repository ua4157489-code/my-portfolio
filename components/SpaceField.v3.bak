"use client";

import { useFrame } from "@react-three/fiber";
import { useEffect, useMemo, useRef } from "react";
import type { MutableRefObject } from "react";
import * as THREE from "three";

type Shared = MutableRefObject<{ p: number; mx: number; my: number }>;
const fadeOf = (p: number) => THREE.MathUtils.smoothstep(p, 0.003, 0.06);

/* ───────── tiny deterministic helpers ───────── */
function rngOf(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
function hash(x: number, y: number, s: number) {
  let h = Math.imul(x, 374761393) + Math.imul(y, 668265263) + Math.imul(s, 1274126177);
  h = Math.imul(h ^ (h >>> 13), 1274126177);
  return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
}
function vnoise(x: number, y: number, s: number) {
  const xi = Math.floor(x), yi = Math.floor(y);
  const xf = x - xi, yf = y - yi;
  const u = xf * xf * (3 - 2 * xf), v = yf * yf * (3 - 2 * yf);
  const a = hash(xi, yi, s), b = hash(xi + 1, yi, s), c = hash(xi, yi + 1, s), d = hash(xi + 1, yi + 1, s);
  return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
}
function fbm(x: number, y: number, s: number) {
  let t = 0, a = 0.5;
  for (let i = 0; i < 5; i++) {
    t += a * vnoise(x, y, s + i);
    x *= 2;
    y *= 2;
    a *= 0.5;
  }
  return t;
}

/* ───────── procedural textures ───────── */
function cloudTexture(seed: number, c1: number[], c2: number[]) {
  const S = 192;
  const cv = document.createElement("canvas");
  cv.width = cv.height = S;
  const ctx = cv.getContext("2d")!;
  const img = ctx.createImageData(S, S);
  for (let y = 0; y < S; y++) {
    for (let x = 0; x < S; x++) {
      const dx = (x / S - 0.5) * 2, dy = (y / S - 0.5) * 2;
      const mk = Math.pow(Math.max(0, 1 - Math.sqrt(dx * dx + dy * dy)), 1.4);
      const n = fbm((x / S) * 3.2, (y / S) * 3.2, seed);
      const m = fbm((x / S) * 2 + 9, (y / S) * 2 + 3, seed + 9);
      const a = Math.min(1, Math.max(0, (n - 0.36) * 2.3)) * mk;
      const boost = 1 + n * n * 0.8;
      const i = (y * S + x) * 4;
      img.data[i] = Math.min(255, (c1[0] + (c2[0] - c1[0]) * m) * boost);
      img.data[i + 1] = Math.min(255, (c1[1] + (c2[1] - c1[1]) * m) * boost);
      img.data[i + 2] = Math.min(255, (c1[2] + (c2[2] - c1[2]) * m) * boost);
      img.data[i + 3] = a * 255;
    }
  }
  ctx.putImageData(img, 0, 0);
  const t = new THREE.CanvasTexture(cv);
  t.colorSpace = THREE.SRGBColorSpace;
  return t;
}

function planetTexture(seed: number) {
  const W = 512, H = 256;
  const cv = document.createElement("canvas");
  cv.width = W;
  cv.height = H;
  const ctx = cv.getContext("2d")!;
  const img = ctx.createImageData(W, H);
  for (let y = 0; y < H; y++) {
    for (let x = 0; x < W; x++) {
      const u = x / W, v = y / H;
      const n = fbm(u * 7, v * 14, seed);
      const band = Math.sin(v * 22 + fbm(u * 3, v * 6, seed + 4) * 5) * 0.5 + 0.5;
      const k = Math.min(1, n * 0.9 + band * 0.45);
      const i = (y * W + x) * 4;
      img.data[i] = 16 + k * 150;
      img.data[i + 1] = 34 + k * 160;
      img.data[i + 2] = 64 + k * 150;
      img.data[i + 3] = 255;
    }
  }
  ctx.putImageData(img, 0, 0);
  const t = new THREE.CanvasTexture(cv);
  t.colorSpace = THREE.SRGBColorSpace;
  return t;
}

function rockTexture() {
  const S = 128;
  const cv = document.createElement("canvas");
  cv.width = cv.height = S;
  const ctx = cv.getContext("2d")!;
  const img = ctx.createImageData(S, S);
  for (let y = 0; y < S; y++) {
    for (let x = 0; x < S; x++) {
      const n = fbm((x / S) * 6, (y / S) * 6, 3);
      const pits = fbm((x / S) * 18, (y / S) * 18, 8);
      const v = 70 + n * 120 - (pits > 0.62 ? 40 : 0);
      const i = (y * S + x) * 4;
      img.data[i] = v;
      img.data[i + 1] = v;
      img.data[i + 2] = v;
      img.data[i + 3] = 255;
    }
  }
  ctx.putImageData(img, 0, 0);
  const t = new THREE.CanvasTexture(cv);
  t.wrapS = t.wrapT = THREE.RepeatWrapping;
  return t;
}

/* ───────── star shader ───────── */
const STAR_VERT = /* glsl */ `
  attribute float aS; attribute vec3 aC; attribute float aP;
  uniform float uT; uniform float uPix; uniform float uFade;
  varying vec3 vC; varying float vA;
  void main(){
    vec4 mv = modelViewMatrix * vec4(position, 1.0);
    gl_Position = projectionMatrix * mv;
    float tw = 0.72 + 0.28 * sin(uT * (0.8 + aP * 2.2) + aP * 40.0);
    vC = aC; vA = tw * uFade;
    gl_PointSize = clamp(aS * uPix * 26.0 / -mv.z, 1.0 * uPix, 15.0 * uPix);
  }`;
const STAR_FRAG = /* glsl */ `
  varying vec3 vC; varying float vA;
  void main(){
    float d = length(gl_PointCoord - 0.5);
    if (d > 0.5) discard;
    float a = exp(-d * d * 30.0);
    gl_FragColor = vec4(vC, a * vA);
  }`;

const PLANET_VERT = /* glsl */ `
  varying vec2 vUv; varying vec3 vWN;
  void main(){
    vUv = uv;
    vWN = normalize(mat3(modelMatrix) * normal);
    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
  }`;
const PLANET_FRAG = /* glsl */ `
  uniform sampler2D uMap; uniform vec3 uSun; uniform float uFade;
  varying vec2 vUv; varying vec3 vWN;
  void main(){
    vec3 n = normalize(vWN);
    float lit = smoothstep(-0.08, 0.55, dot(n, normalize(uSun)));
    vec3 tex = texture2D(uMap, vUv).rgb;
    gl_FragColor = vec4(tex * (0.03 + lit * 1.0), uFade);
    #include <colorspace_fragment>
  }`;

const ATM_VERT = /* glsl */ `
  varying vec3 vN; varying vec3 vV; varying vec3 vW;
  void main(){
    vW = normalize(mat3(modelMatrix) * normal);
    vN = normalize(normalMatrix * normal);
    vec4 mv = modelViewMatrix * vec4(position, 1.0);
    vV = -mv.xyz;
    gl_Position = projectionMatrix * mv;
  }`;
const ATM_FRAG = /* glsl */ `
  uniform vec3 uCol; uniform float uFade; uniform vec3 uSun;
  varying vec3 vN; varying vec3 vV; varying vec3 vW;
  void main(){
    float f = pow(1.0 - abs(dot(normalize(vN), normalize(vV))), 3.0);
    f *= 0.12 + 0.88 * smoothstep(-0.35, 0.5, dot(normalize(vW), normalize(uSun)));
    gl_FragColor = vec4(uCol * f * 1.3, f * uFade);
  }`;

/* ───────── the whole space scene ───────── */
export default function SpaceField({ sh }: { sh: Shared }) {
  const root = useRef<THREE.Group>(null!);
  const starMat = useRef<THREE.ShaderMaterial>(null!);
  const nebula = useRef<THREE.Group>(null!);
  const rocks = useRef<THREE.InstancedMesh>(null!);
  const rockMat = useRef<THREE.MeshStandardMaterial>(null!);
  const planet = useRef<THREE.Mesh>(null!);
  const planetMat = useRef<THREE.ShaderMaterial>(null!);
  const atmMat = useRef<THREE.ShaderMaterial>(null!);
  const dummy = useMemo(() => new THREE.Object3D(), []);
  const sun = useMemo(() => new THREE.Vector3(0.9, 0.35, 0.15), []);
  const rTex = useMemo(() => rockTexture(), []);

  /* stars: many sizes, real colour temperatures, deep z range */
  const stars = useMemo(() => {
    const N = 3900, r = rngOf(7);
    const pos = new Float32Array(N * 3), col = new Float32Array(N * 3), siz = new Float32Array(N), ph = new Float32Array(N);
    const temps = [[0.62, 0.74, 1], [0.85, 0.9, 1], [1, 1, 1], [1, 0.9, 0.72], [1, 0.72, 0.52]];
    for (let i = 0; i < N; i++) {
      const band = i < 1100; // faint milky-way band, tilted
      const dust = i >= N - 260; // sparse motes near the flight path
      if (band) {
        const x = (r() - 0.5) * 100;
        pos[i * 3] = x;
        pos[i * 3 + 1] = x * 0.32 + (r() + r() + r() - 1.5) * 7;
        pos[i * 3 + 2] = -30 - r() * 60;
      } else if (dust) {
        pos[i * 3] = (r() - 0.5) * 16;
        pos[i * 3 + 1] = (r() - 0.5) * 9;
        pos[i * 3 + 2] = 8 - r() * 64;
      } else {
        pos[i * 3] = (r() - 0.5) * 90;
        pos[i * 3 + 1] = (r() - 0.5) * 52;
        pos[i * 3 + 2] = 12 - r() * 100;
      }
      const t = temps[Math.floor(Math.pow(r(), 1.4) * temps.length)];
      const b = (0.5 + r() * 0.5) * (band ? 0.55 : dust ? 0.35 : 1);
      col[i * 3] = t[0] * b;
      col[i * 3 + 1] = t[1] * b;
      col[i * 3 + 2] = t[2] * b;
      siz[i] = dust ? 0.3 + r() * 0.3 : band ? 0.3 + r() * 0.5 : r() < 0.04 ? 1.6 + r() * 1.6 : 0.35 + r() * 0.9; // a few bright ones
      ph[i] = r();
    }
    return { pos, col, siz, ph };
  }, []);

  /* nebula clouds (procedural fbm textures, additive) */
  const clouds = useMemo(() => {
    const r = rngOf(21);
    const pals = [
      [[10, 90, 120], [30, 170, 200]],
      [[70, 30, 140], [150, 80, 230]],
      [[130, 25, 90], [230, 80, 170]],
      [[15, 50, 130], [60, 130, 230]],
    ];
    return Array.from({ length: 10 }, (_, i) => {
      const side = i % 2 ? 1 : -1;
      const pal = pals[i % pals.length];
      return {
        tex: cloudTexture(30 + i * 7, pal[0], pal[1]),
        pos: [side * (6 + r() * 9), (r() - 0.5) * 12, 2 - i * 7.5] as [number, number, number],
        scale: 22 + r() * 14,
        op: 0.22 + r() * 0.16,
        spin: (r() - 0.5) * 0.02,
      };
    });
  }, []);

  /* asteroids: real lit geometry the camera flies between */
  const rockGeo = useMemo(() => {
    const g = new THREE.IcosahedronGeometry(1, 1);
    const p = g.attributes.position;
    for (let i = 0; i < p.count; i++) {
      const x = p.getX(i), y = p.getY(i), z = p.getZ(i);
      const h = Math.sin(x * 12.9898 + y * 78.233 + z * 37.719) * 43758.5453;
      const n = 0.74 + 0.5 * (h - Math.floor(h));
      p.setXYZ(i, x * n, y * n, z * n);
    }
    g.computeVertexNormals();
    return g;
  }, []);
  const rockData = useMemo(() => {
    const r = rngOf(99), N = 90;
    return Array.from({ length: N }, () => {
      const z = 4 - r() * 62;
      const ang = r() * Math.PI * 2;
      let rad = 5 + r() * 9;
      if (z > -14) rad += 5;
      return {
        p: [Math.cos(ang) * rad, Math.sin(ang) * rad * 0.7, z] as [number, number, number],
        s: [0.25 + r() * 0.9, 0.2 + r() * 0.7, 0.25 + r() * 0.8] as [number, number, number],
        rot: [r() * 6, r() * 6, r() * 6] as [number, number, number],
        spin: [(r() - 0.5) * 0.4, (r() - 0.5) * 0.4, (r() - 0.5) * 0.3] as [number, number, number],
        tone: r(),
      };
    });
  }, []);

  const pTex = useMemo(() => planetTexture(5), []);

  useEffect(() => {
    rockData.forEach((d, i) => rocks.current.setColorAt(i, new THREE.Color().setHSL(0.6 + d.tone * 0.05, 0.12 + d.tone * 0.1, 0.3 + d.tone * 0.2)));
    if (rocks.current.instanceColor) rocks.current.instanceColor.needsUpdate = true;
  }, [rockData]);

  useFrame((state, dt) => {
    const f = fadeOf(sh.current.p);
    root.current.visible = f > 0.01;
    if (f <= 0.01) return;
    const t = state.clock.elapsedTime;

    starMat.current.uniforms.uT.value = t;
    starMat.current.uniforms.uFade.value = f;
    starMat.current.uniforms.uPix.value = state.gl.getPixelRatio();

    nebula.current.children.forEach((c, i) => {
      const sp = c as THREE.Sprite;
      sp.material.opacity = clouds[i].op * f;
      sp.material.rotation += clouds[i].spin * dt;
    });

    rockMat.current.opacity = f;
    rockData.forEach((d, i) => {
      d.rot[0] += d.spin[0] * dt;
      d.rot[1] += d.spin[1] * dt;
      d.rot[2] += d.spin[2] * dt;
      dummy.position.set(d.p[0], d.p[1] + Math.sin(t * 0.3 + i) * 0.15, d.p[2]);
      dummy.rotation.set(d.rot[0], d.rot[1], d.rot[2]);
      dummy.scale.set(d.s[0], d.s[1], d.s[2]);
      dummy.updateMatrix();
      rocks.current.setMatrixAt(i, dummy.matrix);
    });
    rocks.current.instanceMatrix.needsUpdate = true;

    planet.current.rotation.y += dt * 0.03;
    planetMat.current.uniforms.uFade.value = f;
    atmMat.current.uniforms.uFade.value = f;
  });

  return (
    <group ref={root}>
      {/* stars */}
      <points frustumCulled={false}>
        <bufferGeometry>
          <bufferAttribute attach="attributes-position" args={[stars.pos, 3]} />
          <bufferAttribute attach="attributes-aC" args={[stars.col, 3]} />
          <bufferAttribute attach="attributes-aS" args={[stars.siz, 1]} />
          <bufferAttribute attach="attributes-aP" args={[stars.ph, 1]} />
        </bufferGeometry>
        <shaderMaterial
          ref={starMat}
          vertexShader={STAR_VERT}
          fragmentShader={STAR_FRAG}
          uniforms={{ uT: { value: 0 }, uPix: { value: 1 }, uFade: { value: 0 } }}
          transparent
          depthWrite={false}
          blending={THREE.AdditiveBlending}
        />
      </points>

      {/* nebula */}
      <group ref={nebula}>
        {clouds.map((c, i) => (
          <sprite key={i} position={c.pos} scale={[c.scale, c.scale, 1]}>
            <spriteMaterial map={c.tex} transparent opacity={0} depthWrite={false} blending={THREE.AdditiveBlending} />
          </sprite>
        ))}
      </group>

      {/* distant planet with atmosphere */}
      <group position={[-13, -3, -36]}>
        <mesh ref={planet} rotation={[0.3, 0, 0.25]}>
          <sphereGeometry args={[7, 64, 48]} />
          <shaderMaterial
            ref={planetMat}
            vertexShader={PLANET_VERT}
            fragmentShader={PLANET_FRAG}
            uniforms={{ uMap: { value: pTex }, uSun: { value: sun }, uFade: { value: 0 } }}
            transparent
          />
        </mesh>
        <mesh scale={1.07}>
          <sphereGeometry args={[7, 48, 32]} />
          <shaderMaterial
            ref={atmMat}
            vertexShader={ATM_VERT}
            fragmentShader={ATM_FRAG}
            uniforms={{ uCol: { value: new THREE.Color("#4fb8ff") }, uFade: { value: 0 }, uSun: { value: sun } }}
            transparent
            depthWrite={false}
            blending={THREE.AdditiveBlending}
          />
        </mesh>
      </group>

      {/* asteroids */}
      <instancedMesh ref={rocks} args={[rockGeo, undefined, rockData.length]} frustumCulled={false}>
        <meshStandardMaterial ref={rockMat} map={rTex} bumpMap={rTex} bumpScale={2} color="#ffffff" roughness={0.95} metalness={0.1} flatShading transparent opacity={0} />
      </instancedMesh>
    </group>
  );
}
