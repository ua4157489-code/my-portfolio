"use client";

import { useFrame } from "@react-three/fiber";
import { useMemo, useRef } from "react";
import type { MutableRefObject } from "react";
import * as THREE from "three";

type Shared = MutableRefObject<{ p: number; mx: number; my: number }>;
const fadeOf = (p: number) => THREE.MathUtils.smoothstep(p, 0.003, 0.06);

// where the black hole sits (x, y, z) and how big it is. Change these to move or resize it.
const BH_POS: [number, number, number] = [13, 4.5, -44];
const BH_SCALE = 2.2;

/* ───────── tiny deterministic helpers ───────── */
function rngOf(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
function hash(x: number, y: number, s: number) {
  let h = Math.imul(x, 374761393) + Math.imul(y, 668265263) + Math.imul(s, 1274126177);
  h = Math.imul(h ^ (h >>> 13), 1274126177);
  return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
}
function vnoise(x: number, y: number, s: number) {
  const xi = Math.floor(x), yi = Math.floor(y);
  const xf = x - xi, yf = y - yi;
  const u = xf * xf * (3 - 2 * xf), v = yf * yf * (3 - 2 * yf);
  const a = hash(xi, yi, s), b = hash(xi + 1, yi, s), c = hash(xi, yi + 1, s), d = hash(xi + 1, yi + 1, s);
  return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
}
function fbm(x: number, y: number, s: number) {
  let t = 0, a = 0.5;
  for (let i = 0; i < 5; i++) {
    t += a * vnoise(x, y, s + i);
    x *= 2;
    y *= 2;
    a *= 0.5;
  }
  return t;
}

/* ───────── procedural textures ───────── */
function cloudTexture(seed: number, c1: number[], c2: number[]) {
  const S = 192;
  const cv = document.createElement("canvas");
  cv.width = cv.height = S;
  const ctx = cv.getContext("2d")!;
  const img = ctx.createImageData(S, S);
  for (let y = 0; y < S; y++) {
    for (let x = 0; x < S; x++) {
      const dx = (x / S - 0.5) * 2, dy = (y / S - 0.5) * 2;
      const mk = Math.pow(Math.max(0, 1 - Math.sqrt(dx * dx + dy * dy)), 1.4);
      const n = fbm((x / S) * 3.2, (y / S) * 3.2, seed);
      const m = fbm((x / S) * 2 + 9, (y / S) * 2 + 3, seed + 9);
      const a = Math.min(1, Math.max(0, (n - 0.36) * 2.3)) * mk;
      const boost = 1 + n * n * 0.8;
      const i = (y * S + x) * 4;
      img.data[i] = Math.min(255, (c1[0] + (c2[0] - c1[0]) * m) * boost);
      img.data[i + 1] = Math.min(255, (c1[1] + (c2[1] - c1[1]) * m) * boost);
      img.data[i + 2] = Math.min(255, (c1[2] + (c2[2] - c1[2]) * m) * boost);
      img.data[i + 3] = a * 255;
    }
  }
  ctx.putImageData(img, 0, 0);
  const t = new THREE.CanvasTexture(cv);
  t.colorSpace = THREE.SRGBColorSpace;
  return t;
}

function planetTexture(seed: number) {
  const W = 512, H = 256;
  const cv = document.createElement("canvas");
  cv.width = W;
  cv.height = H;
  const ctx = cv.getContext("2d")!;
  const img = ctx.createImageData(W, H);
  for (let y = 0; y < H; y++) {
    for (let x = 0; x < W; x++) {
      const u = x / W, v = y / H;
      const n = fbm(u * 7, v * 14, seed);
      const band = Math.sin(v * 22 + fbm(u * 3, v * 6, seed + 4) * 5) * 0.5 + 0.5;
      const k = Math.min(1, n * 0.9 + band * 0.45);
      const i = (y * W + x) * 4;
      img.data[i] = 16 + k * 150;
      img.data[i + 1] = 34 + k * 160;
      img.data[i + 2] = 64 + k * 150;
      img.data[i + 3] = 255;
    }
  }
  ctx.putImageData(img, 0, 0);
  const t = new THREE.CanvasTexture(cv);
  t.colorSpace = THREE.SRGBColorSpace;
  return t;
}

// soft round glow (used around the black hole)
function glowTexture() {
  const S = 128;
  const cv = document.createElement("canvas");
  cv.width = cv.height = S;
  const ctx = cv.getContext("2d")!;
  const g = ctx.createRadialGradient(S / 2, S / 2, 0, S / 2, S / 2, S / 2);
  g.addColorStop(0, "rgba(255,190,110,0.9)");
  g.addColorStop(0.25, "rgba(255,120,40,0.35)");
  g.addColorStop(1, "rgba(255,80,20,0)");
  ctx.fillStyle = g;
  ctx.fillRect(0, 0, S, S);
  const t = new THREE.CanvasTexture(cv);
  t.colorSpace = THREE.SRGBColorSpace;
  return t;
}

/* ───────── asteroid geometry: lumpy, cratered, smooth-shaded ───────── */
function asteroidGeo(seed: number, tints: Float32Array) {
  const g = new THREE.SphereGeometry(1, 56, 40);
  const pos = g.attributes.position as THREE.BufferAttribute;
  const r = rngOf(seed);
  const craters = Array.from({ length: 10 }, () => {
    const a = r() * Math.PI * 2, b = Math.acos(2 * r() - 1);
    return {
      d: new THREE.Vector3(Math.sin(b) * Math.cos(a), Math.cos(b), Math.sin(b) * Math.sin(a)),
      rad: 0.25 + r() * 0.4,
      dep: 0.05 + r() * 0.13,
    };
  });
  const v = new THREE.Vector3();
  for (let i = 0; i < pos.count; i++) {
    v.fromBufferAttribute(pos, i).normalize();
    let k =
      1 +
      (fbm(v.x * 1.7 + v.z * 0.9, v.y * 1.7 - v.z * 1.3, seed) - 0.5) * 0.7 +
      (fbm(v.x * 5 + v.y * 3, v.z * 5 - v.y * 2, seed + 3) - 0.5) * 0.14;
    for (const c of craters) {
      const t = Math.acos(Math.min(1, Math.max(-1, v.dot(c.d)))) / c.rad;
      if (t < 1) k -= c.dep * (1 - t * t); // bowl
      else if (t < 1.25) k += c.dep * 0.35 * (1 - (t - 1) / 0.25); // raised rim
    }
    pos.setXYZ(i, v.x * k, v.y * k, v.z * k);
  }
  g.computeVertexNormals();
  // the sphere has a seam: average the normals of vertices that share a position
  const nor = g.attributes.normal as THREE.BufferAttribute;
  const key = (i: number) => `${Math.round(pos.getX(i) * 1e4)},${Math.round(pos.getY(i) * 1e4)},${Math.round(pos.getZ(i) * 1e4)}`;
  const sums = new Map<string, THREE.Vector3>();
  for (let i = 0; i < pos.count; i++) {
    const s = sums.get(key(i)) ?? new THREE.Vector3();
    s.x += nor.getX(i);
    s.y += nor.getY(i);
    s.z += nor.getZ(i);
    sums.set(key(i), s);
  }
  for (let i = 0; i < pos.count; i++) {
    const n = sums.get(key(i))!.clone().normalize();
    nor.setXYZ(i, n.x, n.y, n.z);
  }
  nor.needsUpdate = true;
  g.setAttribute("aTint", new THREE.InstancedBufferAttribute(tints, 3));
  return g;
}

/* ───────── shaders ───────── */
const NOISE3 = /* glsl */ `
  float h3(vec3 p){ p = fract(p * 0.3183099 + 0.1); p *= 17.0; return fract(p.x * p.y * p.z * (p.x + p.y + p.z)); }
  float n3(vec3 x){
    vec3 i = floor(x); vec3 f = fract(x); f = f * f * (3.0 - 2.0 * f);
    return mix(mix(mix(h3(i + vec3(0.0,0.0,0.0)), h3(i + vec3(1.0,0.0,0.0)), f.x),
                   mix(h3(i + vec3(0.0,1.0,0.0)), h3(i + vec3(1.0,1.0,0.0)), f.x), f.y),
               mix(mix(h3(i + vec3(0.0,0.0,1.0)), h3(i + vec3(1.0,0.0,1.0)), f.x),
                   mix(h3(i + vec3(0.0,1.0,1.0)), h3(i + vec3(1.0,1.0,1.0)), f.x), f.y), f.z);
  }
  float fbm3(vec3 p){
    float s = 0.0; float a = 0.5;
    for (int i = 0; i < 4; i++){ s += a * n3(p); p = p * 2.03 + vec3(1.7, 9.2, 3.1); a *= 0.5; }
    return s;
  }
  vec3 heat(float t){
    vec3 c0 = vec3(1.0, 0.97, 0.9);
    vec3 c1 = vec3(1.0, 0.72, 0.32);
    vec3 c2 = vec3(0.85, 0.28, 0.08);
    vec3 c3 = vec3(0.25, 0.05, 0.02);
    if (t < 0.25) return mix(c0, c1, t / 0.25);
    if (t < 0.6) return mix(c1, c2, (t - 0.25) / 0.35);
    return mix(c2, c3, (t - 0.6) / 0.4);
  }
`;

const STAR_VERT = /* glsl */ `
  attribute float aS; attribute vec3 aC; attribute float aP;
  uniform float uT; uniform float uPix; uniform float uFade;
  varying vec3 vC; varying float vA;
  void main(){
    vec4 mv = modelViewMatrix * vec4(position, 1.0);
    gl_Position = projectionMatrix * mv;
    float tw = 0.72 + 0.28 * sin(uT * (0.8 + aP * 2.2) + aP * 40.0);
    vC = aC; vA = tw * uFade;
    gl_PointSize = clamp(aS * uPix * 26.0 / -mv.z, 1.0 * uPix, 15.0 * uPix);
  }`;
const STAR_FRAG = /* glsl */ `
  varying vec3 vC; varying float vA;
  void main(){
    float d = length(gl_PointCoord - 0.5);
    if (d > 0.5) discard;
    float a = exp(-d * d * 30.0);
    gl_FragColor = vec4(vC, a * vA);
  }`;

const PLANET_VERT = /* glsl */ `
  varying vec2 vUv; varying vec3 vWN;
  void main(){
    vUv = uv;
    vWN = normalize(mat3(modelMatrix) * normal);
    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
  }`;
const PLANET_FRAG = /* glsl */ `
  uniform sampler2D uMap; uniform vec3 uSun; uniform float uFade;
  varying vec2 vUv; varying vec3 vWN;
  void main(){
    vec3 n = normalize(vWN);
    float lit = smoothstep(-0.08, 0.55, dot(n, normalize(uSun)));
    vec3 tex = texture2D(uMap, vUv).rgb;
    gl_FragColor = vec4(tex * (0.03 + lit * 1.0), uFade);
    #include <colorspace_fragment>
  }`;

const ATM_VERT = /* glsl */ `
  varying vec3 vN; varying vec3 vV; varying vec3 vW;
  void main(){
    vW = normalize(mat3(modelMatrix) * normal);
    vN = normalize(normalMatrix * normal);
    vec4 mv = modelViewMatrix * vec4(position, 1.0);
    vV = -mv.xyz;
    gl_Position = projectionMatrix * mv;
  }`;
const ATM_FRAG = /* glsl */ `
  uniform vec3 uCol; uniform float uFade; uniform vec3 uSun;
  varying vec3 vN; varying vec3 vV; varying vec3 vW;
  void main(){
    float f = pow(1.0 - abs(dot(normalize(vN), normalize(vV))), 3.0);
    f *= 0.12 + 0.88 * smoothstep(-0.35, 0.5, dot(normalize(vW), normalize(uSun)));
    gl_FragColor = vec4(uCol * f * 1.3, f * uFade);
  }`;

// asteroids: lit by the same sun as the planet, with surface bumps, so they are never black
const ROCK_VERT = /* glsl */ `
  attribute vec3 aTint;
  varying vec3 vN; varying vec3 vP; varying vec3 vO; varying vec3 vT;
  void main(){
    vO = position;
    vT = aTint;
    mat4 im = mat4(1.0);
    #ifdef USE_INSTANCING
      im = instanceMatrix;
    #endif
    vec4 wp = modelMatrix * im * vec4(position, 1.0);
    vP = wp.xyz;
    vN = normalize(mat3(modelMatrix) * mat3(im) * normal);
    gl_Position = projectionMatrix * viewMatrix * wp;
  }`;
const ROCK_FRAG = /* glsl */ `
  uniform vec3 uSun; uniform float uFade;
  varying vec3 vN; varying vec3 vP; varying vec3 vO; varying vec3 vT;
  ${NOISE3}
  void main(){
    vec3 n = normalize(vN);
    // rocky surface: big lumps, small grain and a few dark streaks
    float h = fbm3(vO * 5.0) * 0.75 + n3(vO * 26.0) * 0.25;
    float streak = n3(vec3(vO.x * 2.0, vO.y * 14.0, vO.z * 2.0));
    // bump mapping from the screen-space slope of the height
    vec3 dx = dFdx(vP); vec3 dy = dFdy(vP);
    vec3 r1 = cross(dy, n); vec3 r2 = cross(n, dx);
    float det = dot(dx, r1);
    vec3 grad = sign(det) * (dFdx(h) * r1 + dFdy(h) * r2);
    n = normalize(abs(det) * n - grad * 0.22);
    vec3 base = vT * (0.28 + 0.95 * h) * (0.78 + 0.35 * streak);
    vec3 L = normalize(uSun);
    vec3 V = normalize(cameraPosition - vP);
    float ndl = dot(n, L);
    float diff = pow(clamp((ndl + 0.08) / 1.08, 0.0, 1.0), 1.15);
    vec3 H = normalize(L + V);
    float spec = pow(max(dot(n, H), 0.0), 22.0) * 0.1 * diff;
    float rim = pow(1.0 - max(dot(n, V), 0.0), 3.0) * 0.16;
    vec3 col = base * (0.05 + diff * 1.3) * vec3(1.0, 0.96, 0.9)
             + spec * vec3(1.0, 0.95, 0.85)
             + rim * vec3(0.25, 0.45, 0.9) * (0.35 + 0.65 * (1.0 - diff));
    gl_FragColor = vec4(col, uFade);
  }`;

// black hole: hot, streaky accretion disk seen almost edge-on (left side comes toward us and is brighter)
const DISK_VERT = /* glsl */ `
  varying vec2 vP;
  void main(){
    vP = position.xy;
    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
  }`;
const DISK_FRAG = /* glsl */ `
  uniform float uT; uniform float uFade; uniform float uIn; uniform float uOut;
  varying vec2 vP;
  ${NOISE3}
  void main(){
    float r = length(vP);
    float t = clamp((r - uIn) / (uOut - uIn), 0.0, 1.0);
    float ang = atan(vP.y, vP.x);
    float a2 = ang + uT * 0.9 / pow(max(r, 0.5), 1.5); // inner gas orbits faster
    float n1 = fbm3(vec3(cos(a2) * 3.0, sin(a2) * 3.0, r * 9.0));
    float n2 = fbm3(vec3(cos(a2) * 8.0 + 3.0, sin(a2) * 8.0, r * 24.0));
    float streak = 0.4 + 0.8 * n1 + 0.4 * n2;
    float dop = mix(0.3, 1.7, pow(0.5 - 0.5 * cos(ang), 1.6));
    float edge = smoothstep(0.0, 0.07, t) * (1.0 - smoothstep(0.7, 1.0, t));
    float inten = pow(1.0 - t, 1.6) * 2.1 + 0.12;
    vec3 col = heat(t) * streak * dop * inten * edge;
    gl_FragColor = vec4(col, uFade);
  }`;

// camera-facing layer: the thin photon ring and the far side of the disk bent over the top and under the bottom
const HALO_VERT = /* glsl */ `
  varying vec2 vUv;
  void main(){
    vUv = uv;
    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
  }`;
const HALO_FRAG = /* glsl */ `
  uniform float uT; uniform float uFade; uniform float uHalf;
  varying vec2 vUv;
  ${NOISE3}
  void main(){
    vec2 q = (vUv - 0.5) * 2.0 * uHalf;
    float r = length(q);
    if (r > uHalf) discard;
    float ang = atan(q.y, q.x);
    float dop = mix(0.35, 1.5, pow(0.5 - 0.5 * cos(ang), 1.4));
    float rd = (r - 1.07) / 0.03;
    float ring = exp(-rd * rd) * 1.6;
    float band = smoothstep(1.06, 1.16, r) * (1.0 - smoothstep(1.7, 3.0, r));
    float vert = pow(abs(sin(ang)), 0.9);
    float tt = clamp((r - 1.06) / 1.9, 0.0, 1.0);
    float sp = uT * 0.9 / pow(max(r * 1.2, 0.5), 1.5);
    float n = fbm3(vec3(cos(ang + sp) * 3.0, sin(ang + sp) * 3.0, r * 9.0));
    vec3 arc = heat(tt * 0.8) * band * vert * (0.5 + 0.9 * n) * dop * 1.7 * pow(1.0 - tt, 1.2);
    float glow = exp(-(r - 1.0) * 1.4) * 0.14;
    vec3 col = arc + heat(0.12) * (ring * dop) + vec3(1.0, 0.55, 0.25) * glow * smoothstep(1.0, 1.15, r);
    gl_FragColor = vec4(col, uFade);
  }`;

// gas and dust spiralling inward
const GAS_VERT = /* glsl */ `
  attribute vec4 aD;
  uniform float uT; uniform float uFade; uniform float uPix;
  varying vec3 vC; varying float vA;
  void main(){
    float life = fract(aD.w + uT * 0.035);
    float r = mix(aD.x, 1.25, pow(life, 1.6));
    float a = aD.y + uT * 1.26 / pow(r, 1.5);
    vec3 p = vec3(cos(a) * r, sin(a) * r, aD.z * (0.3 + r * 0.12) * (1.0 - life * 0.7));
    vec4 mv = modelViewMatrix * vec4(p, 1.0);
    gl_Position = projectionMatrix * mv;
    float t = clamp((r - 1.25) / 4.75, 0.0, 1.0);
    vC = mix(vec3(1.0, 0.9, 0.7), vec3(1.0, 0.45, 0.15), t);
    float dop = mix(0.4, 1.5, pow(0.5 - 0.5 * cos(a), 1.5));
    vA = uFade * dop * smoothstep(0.0, 0.08, life) * (1.0 - smoothstep(0.85, 1.0, life)) * (0.5 + 0.5 * aD.w);
    gl_PointSize = clamp(uPix * 110.0 * (1.0 + (1.0 - t) * 0.8) / -mv.z, uPix, 7.0 * uPix);
  }`;

// a comet: a bright head with a fading tail of points
const COMET_VERT = /* glsl */ `
  attribute float aK;
  uniform vec3 uHead; uniform vec3 uDir; uniform float uLen; uniform float uAlive; uniform float uPix;
  varying vec3 vC; varying float vA;
  void main(){
    vec3 p = uHead - uDir * aK * uLen;
    vec4 mv = modelViewMatrix * vec4(p, 1.0);
    gl_Position = projectionMatrix * mv;
    vC = mix(vec3(1.0, 0.97, 0.9), vec3(0.4, 0.75, 1.0), aK);
    vA = uAlive * pow(1.0 - aK, 1.8);
    gl_PointSize = clamp(uPix * mix(170.0, 30.0, aK) / -mv.z, uPix, 14.0 * uPix);
  }`;

/* ───────── asteroid layout ───────── */
type Rock = {
  p: [number, number, number];
  s: [number, number, number];
  rot: [number, number, number];
  spin: [number, number, number];
};

// real-looking colours: grey, brown, ochre and a darker grey-blue (never pure black)
const PALETTE = [
  [0.58, 0.54, 0.5],
  [0.52, 0.4, 0.3],
  [0.66, 0.55, 0.4],
  [0.38, 0.38, 0.43],
];

/* ───────── the whole space scene ───────── */
export default function SpaceField({ sh }: { sh: Shared }) {
  const root = useRef<THREE.Group>(null!);
  const starMat = useRef<THREE.ShaderMaterial>(null!);
  const nebula = useRef<THREE.Group>(null!);
  const planet = useRef<THREE.Mesh>(null!);
  const planetMat = useRef<THREE.ShaderMaterial>(null!);
  const atmMat = useRef<THREE.ShaderMaterial>(null!);
  const rockMeshes = useRef<THREE.InstancedMesh[]>([]);
  const dummy = useMemo(() => new THREE.Object3D(), []);
  const sun = useMemo(() => new THREE.Vector3(0.9, 0.35, 0.15), []);

  // black hole parts
  const holeBody = useRef<THREE.MeshBasicMaterial>(null!);
  const diskMat = useRef<THREE.ShaderMaterial>(null!);
  const haloMat = useRef<THREE.ShaderMaterial>(null!);
  const gasMat = useRef<THREE.ShaderMaterial>(null!);
  const glowMat = useRef<THREE.SpriteMaterial>(null!);
  const halo = useRef<THREE.Mesh>(null!);
  const disk = useRef<THREE.Group>(null!);

  // comet
  const cometMat = useRef<THREE.ShaderMaterial>(null!);
  const comet = useRef({ active: false, t0: 0, life: 2, next: 4, start: new THREE.Vector3(), dir: new THREE.Vector3(), speed: 40, len: 9 });
  const tmpA = useMemo(() => new THREE.Vector3(), []);
  const tmpB = useMemo(() => new THREE.Vector3(), []);
  const tmpC = useMemo(() => new THREE.Vector3(), []);

  /* stars: many sizes, real colour temperatures, deep z range */
  const stars = useMemo(() => {
    const N = 3900, r = rngOf(7);
    const pos = new Float32Array(N * 3), col = new Float32Array(N * 3), siz = new Float32Array(N), ph = new Float32Array(N);
    const temps = [[0.62, 0.74, 1], [0.85, 0.9, 1], [1, 1, 1], [1, 0.9, 0.72], [1, 0.72, 0.52]];
    for (let i = 0; i < N; i++) {
      const band = i < 1100; // faint milky-way band, tilted
      const dust = i >= N - 260; // sparse motes near the flight path
      if (band) {
        const x = (r() - 0.5) * 100;
        pos[i * 3] = x;
        pos[i * 3 + 1] = x * 0.32 + (r() + r() + r() - 1.5) * 7;
        pos[i * 3 + 2] = -30 - r() * 60;
      } else if (dust) {
        pos[i * 3] = (r() - 0.5) * 16;
        pos[i * 3 + 1] = (r() - 0.5) * 9;
        pos[i * 3 + 2] = 8 - r() * 64;
      } else {
        pos[i * 3] = (r() - 0.5) * 90;
        pos[i * 3 + 1] = (r() - 0.5) * 52;
        pos[i * 3 + 2] = 12 - r() * 100;
      }
      const t = temps[Math.floor(Math.pow(r(), 1.4) * temps.length)];
      const b = (0.5 + r() * 0.5) * (band ? 0.55 : dust ? 0.35 : 1);
      col[i * 3] = t[0] * b;
      col[i * 3 + 1] = t[1] * b;
      col[i * 3 + 2] = t[2] * b;
      siz[i] = dust ? 0.3 + r() * 0.3 : band ? 0.3 + r() * 0.5 : r() < 0.04 ? 1.6 + r() * 1.6 : 0.35 + r() * 0.9; // a few bright ones
      ph[i] = r();
    }
    return { pos, col, siz, ph };
  }, []);

  /* nebula clouds (procedural fbm textures, additive) */
  const clouds = useMemo(() => {
    const r = rngOf(21);
    const pals = [
      [[10, 90, 120], [30, 170, 200]],
      [[70, 30, 140], [150, 80, 230]],
      [[130, 25, 90], [230, 80, 170]],
      [[15, 50, 130], [60, 130, 230]],
    ];
    return Array.from({ length: 10 }, (_, i) => {
      const side = i % 2 ? 1 : -1;
      const pal = pals[i % pals.length];
      return {
        tex: cloudTexture(30 + i * 7, pal[0], pal[1]),
        pos: [side * (6 + r() * 9), (r() - 0.5) * 12, 2 - i * 7.5] as [number, number, number],
        scale: 22 + r() * 14,
        op: 0.22 + r() * 0.16,
        spin: (r() - 0.5) * 0.02,
      };
    });
  }, []);

  /* asteroids: three different lumpy shapes, each with its own colours and tumble */
  const rockGroups = useMemo(() => {
    const r = rngOf(99);
    const counts = [36, 30, 24];
    return counts.map((count, gi) => {
      const rocks: Rock[] = [];
      const tints = new Float32Array(count * 3);
      for (let i = 0; i < count; i++) {
        const near = gi === 0 && i < 3; // a few big ones that pass close to the camera path
        const z = near ? -8 - i * 12 : 4 - r() * 62;
        const ang = r() * Math.PI * 2;
        let rad = near ? 3.6 + r() * 0.8 : 5 + r() * 9;
        if (!near && z > -14) rad += 5;
        const b = near ? 1.1 + r() * 0.5 : 0.18 + r() * r() * 1.1;
        rocks.push({
          p: [Math.cos(ang) * rad, Math.sin(ang) * rad * 0.7, z],
          s: [b * (0.8 + r() * 0.5), b * (0.55 + r() * 0.5), b * (0.7 + r() * 0.5)],
          rot: [r() * 6, r() * 6, r() * 6],
          spin: [(r() - 0.5) * 0.4, (r() - 0.5) * 0.4, (r() - 0.5) * 0.3],
        });
        const c = PALETTE[Math.floor(r() * PALETTE.length)];
        const k = 0.85 + r() * 0.3;
        tints[i * 3] = c[0] * k;
        tints[i * 3 + 1] = c[1] * k;
        tints[i * 3 + 2] = c[2] * k;
      }
      return { geo: asteroidGeo(11 + gi * 17, tints), rocks };
    });
  }, []);

  const rockMat = useMemo(
    () =>
      new THREE.ShaderMaterial({
        vertexShader: ROCK_VERT,
        fragmentShader: ROCK_FRAG,
        transparent: true,
        uniforms: { uSun: { value: sun }, uFade: { value: 0 } },
      }),
    [sun]
  );

  const pTex = useMemo(() => planetTexture(5), []);
  const gTex = useMemo(() => glowTexture(), []);

  /* gas particles for the black hole disk */
  const gas = useMemo(() => {
    const N = 1500, r = rngOf(5);
    const d = new Float32Array(N * 4);
    for (let i = 0; i < N; i++) {
      d[i * 4] = 1.6 + Math.pow(r(), 0.8) * 4.4; // starting radius
      d[i * 4 + 1] = r() * Math.PI * 2; // starting angle
      d[i * 4 + 2] = r() * 2 - 1; // height
      d[i * 4 + 3] = r(); // lifetime offset
    }
    return d;
  }, []);
  const gasPos = useMemo(() => new Float32Array(1500 * 3), []);

  const cometK = useMemo(() => {
    const n = 64;
    const k = new Float32Array(n);
    for (let i = 0; i < n; i++) k[i] = i / (n - 1);
    return k;
  }, []);
  const cometPos = useMemo(() => new Float32Array(64 * 3), []);

  useFrame((state, dt) => {
    const f = fadeOf(sh.current.p);
    root.current.visible = f > 0.01;
    if (f <= 0.01) return;
    const t = state.clock.elapsedTime;
    const pix = state.gl.getPixelRatio();

    starMat.current.uniforms.uT.value = t;
    starMat.current.uniforms.uFade.value = f;
    starMat.current.uniforms.uPix.value = pix;

    nebula.current.children.forEach((c, i) => {
      const sp = c as THREE.Sprite;
      sp.material.opacity = clouds[i].op * f;
      sp.material.rotation += clouds[i].spin * dt;
    });

    // asteroids tumble slowly and bob a little
    rockMat.uniforms.uFade.value = f;
    rockGroups.forEach((g, gi) => {
      const mesh = rockMeshes.current[gi];
      if (!mesh) return;
      g.rocks.forEach((d, i) => {
        d.rot[0] += d.spin[0] * dt;
        d.rot[1] += d.spin[1] * dt;
        d.rot[2] += d.spin[2] * dt;
        dummy.position.set(d.p[0], d.p[1] + Math.sin(t * 0.3 + i + gi) * 0.15, d.p[2]);
        dummy.rotation.set(d.rot[0], d.rot[1], d.rot[2]);
        dummy.scale.set(d.s[0], d.s[1], d.s[2]);
        dummy.updateMatrix();
        mesh.setMatrixAt(i, dummy.matrix);
      });
      mesh.instanceMatrix.needsUpdate = true;
    });

    planet.current.rotation.y += dt * 0.03;
    planetMat.current.uniforms.uFade.value = f;
    atmMat.current.uniforms.uFade.value = f;

    // black hole
    holeBody.current.opacity = f;
    diskMat.current.uniforms.uT.value = t;
    diskMat.current.uniforms.uFade.value = f;
    haloMat.current.uniforms.uT.value = t;
    haloMat.current.uniforms.uFade.value = f;
    gasMat.current.uniforms.uT.value = t;
    gasMat.current.uniforms.uFade.value = f;
    gasMat.current.uniforms.uPix.value = pix;
    glowMat.current.opacity = 0.34 * f;
    halo.current.quaternion.copy(state.camera.quaternion);
    disk.current.rotation.z = 0.12 + Math.sin(t * 0.07) * 0.03;

    // comet: every so often one streaks across the view
    const c = comet.current;
    if (!c.active && t > c.next) {
      const cam = state.camera;
      cam.getWorldDirection(tmpA); // forward
      tmpB.crossVectors(tmpA, cam.up).normalize(); // right
      tmpC.crossVectors(tmpB, tmpA).normalize(); // up
      const side = Math.random() < 0.5 ? -1 : 1;
      const dist = 28 + Math.random() * 14;
      c.start
        .copy(cam.position)
        .addScaledVector(tmpA, dist)
        .addScaledVector(tmpB, side * (14 + Math.random() * 8))
        .addScaledVector(tmpC, (Math.random() - 0.5) * 14);
      c.dir
        .copy(tmpB)
        .multiplyScalar(-side * 0.9)
        .addScaledVector(tmpC, -0.25 + Math.random() * 0.3)
        .normalize();
      c.speed = 30 + Math.random() * 14;
      c.life = 1.5 + Math.random() * 0.8;
      c.len = 7 + Math.random() * 4;
      c.t0 = t;
      c.active = true;
    }
    let alive = 0;
    if (c.active) {
      const age = t - c.t0;
      if (age > c.life) {
        c.active = false;
        c.next = t + 5 + Math.random() * 9;
      } else {
        alive = Math.sqrt(Math.sin((age / c.life) * Math.PI)) * f;
        tmpA.copy(c.start).addScaledVector(c.dir, c.speed * age);
        cometMat.current.uniforms.uHead.value.copy(tmpA);
        cometMat.current.uniforms.uDir.value.copy(c.dir);
        cometMat.current.uniforms.uLen.value = c.len;
      }
    }
    cometMat.current.uniforms.uAlive.value = alive;
    cometMat.current.uniforms.uPix.value = pix;
  });

  return (
    <group ref={root}>
      {/* stars */}
      <points frustumCulled={false}>
        <bufferGeometry>
          <bufferAttribute attach="attributes-position" args={[stars.pos, 3]} />
          <bufferAttribute attach="attributes-aC" args={[stars.col, 3]} />
          <bufferAttribute attach="attributes-aS" args={[stars.siz, 1]} />
          <bufferAttribute attach="attributes-aP" args={[stars.ph, 1]} />
        </bufferGeometry>
        <shaderMaterial
          ref={starMat}
          vertexShader={STAR_VERT}
          fragmentShader={STAR_FRAG}
          uniforms={{ uT: { value: 0 }, uPix: { value: 1 }, uFade: { value: 0 } }}
          transparent
          depthWrite={false}
          blending={THREE.AdditiveBlending}
        />
      </points>

      {/* nebula */}
      <group ref={nebula}>
        {clouds.map((c, i) => (
          <sprite key={i} position={c.pos} scale={[c.scale, c.scale, 1]}>
            <spriteMaterial map={c.tex} transparent opacity={0} depthWrite={false} blending={THREE.AdditiveBlending} />
          </sprite>
        ))}
      </group>

      {/* distant planet with atmosphere */}
      <group position={[-13, -3, -36]}>
        <mesh ref={planet} rotation={[0.3, 0, 0.25]}>
          <sphereGeometry args={[7, 64, 48]} />
          <shaderMaterial
            ref={planetMat}
            vertexShader={PLANET_VERT}
            fragmentShader={PLANET_FRAG}
            uniforms={{ uMap: { value: pTex }, uSun: { value: sun }, uFade: { value: 0 } }}
            transparent
          />
        </mesh>
        <mesh scale={1.07}>
          <sphereGeometry args={[7, 48, 32]} />
          <shaderMaterial
            ref={atmMat}
            vertexShader={ATM_VERT}
            fragmentShader={ATM_FRAG}
            uniforms={{ uCol: { value: new THREE.Color("#4fb8ff") }, uFade: { value: 0 }, uSun: { value: sun } }}
            transparent
            depthWrite={false}
            blending={THREE.AdditiveBlending}
          />
        </mesh>
      </group>

      {/* black hole */}
      <group position={BH_POS} scale={BH_SCALE}>
        {/* the shadow: pure black, hides everything behind it */}
        <mesh renderOrder={-10}>
          <sphereGeometry args={[0.985, 48, 32]} />
          <meshBasicMaterial ref={holeBody} color="#000000" transparent opacity={0} />
        </mesh>

        <sprite scale={[15, 15, 1]}>
          <spriteMaterial ref={glowMat} map={gTex} transparent opacity={0} depthWrite={false} blending={THREE.AdditiveBlending} />
        </sprite>

        {/* disk, tilted almost edge-on, with gas spiralling in */}
        <group ref={disk} rotation={[-1.28, 0, 0.12]}>
          <mesh>
            <ringGeometry args={[1.35, 5.8, 160, 8]} />
            <shaderMaterial
              ref={diskMat}
              vertexShader={DISK_VERT}
              fragmentShader={DISK_FRAG}
              uniforms={{ uT: { value: 0 }, uFade: { value: 0 }, uIn: { value: 1.35 }, uOut: { value: 5.8 } }}
              transparent
              depthWrite={false}
              side={THREE.DoubleSide}
              blending={THREE.AdditiveBlending}
            />
          </mesh>
          <points frustumCulled={false}>
            <bufferGeometry>
              <bufferAttribute attach="attributes-position" args={[gasPos, 3]} />
              <bufferAttribute attach="attributes-aD" args={[gas, 4]} />
            </bufferGeometry>
            <shaderMaterial
              ref={gasMat}
              vertexShader={GAS_VERT}
              fragmentShader={STAR_FRAG}
              uniforms={{ uT: { value: 0 }, uFade: { value: 0 }, uPix: { value: 1 } }}
              transparent
              depthWrite={false}
              blending={THREE.AdditiveBlending}
            />
          </points>
        </group>

        {/* bent light: photon ring and the far side of the disk arching over the top and bottom */}
        <mesh ref={halo}>
          <planeGeometry args={[12, 12]} />
          <shaderMaterial
            ref={haloMat}
            vertexShader={HALO_VERT}
            fragmentShader={HALO_FRAG}
            uniforms={{ uT: { value: 0 }, uFade: { value: 0 }, uHalf: { value: 6 } }}
            transparent
            depthWrite={false}
            blending={THREE.AdditiveBlending}
          />
        </mesh>
      </group>

      {/* asteroids */}
      {rockGroups.map((g, gi) => (
        <instancedMesh
          key={gi}
          ref={(m) => {
            if (m) rockMeshes.current[gi] = m;
          }}
          args={[g.geo, rockMat, g.rocks.length]}
          frustumCulled={false}
        />
      ))}

      {/* comet */}
      <points frustumCulled={false}>
        <bufferGeometry>
          <bufferAttribute attach="attributes-position" args={[cometPos, 3]} />
          <bufferAttribute attach="attributes-aK" args={[cometK, 1]} />
        </bufferGeometry>
        <shaderMaterial
          ref={cometMat}
          vertexShader={COMET_VERT}
          fragmentShader={STAR_FRAG}
          uniforms={{
            uHead: { value: new THREE.Vector3() },
            uDir: { value: new THREE.Vector3(1, 0, 0) },
            uLen: { value: 8 },
            uAlive: { value: 0 },
            uPix: { value: 1 },
          }}
          transparent
          depthWrite={false}
          blending={THREE.AdditiveBlending}
        />
      </points>
    </group>
  );
}
